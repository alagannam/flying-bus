# Supabase — public (safe for client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase — server only (NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Thirdweb — server only
THIRDWEB_SECRET_KEY=your-thirdweb-secret-key
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=your-thirdweb-client-id

# Mux — server only
MUX_TOKEN_ID=your-mux-token-id
MUX_TOKEN_SECRET=your-mux-token-secret
MUX_WEBHOOK_SECRET=your-mux-webhook-secret

# Resend — server only
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=hello@theflyingbus.com
RESEND_FROM_NAME=The Flying Bus

# OpenAI — server only (for content moderation)
OPENAI_API_KEY=your-openai-api-key

# App URLs
NEXT_PUBLIC_APP_URL=https://app.theflyingbus.com
NEXT_PUBLIC_SITE_URL=https://theflyingbus.com

# Guardian invite token signing secret — server only
GUARDIAN_INVITE_SECRET=a-long-random-secret-string
